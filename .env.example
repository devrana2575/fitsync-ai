PORT=5000
MONGODB_URI=mongodb://localhost:27017/fitsync-ai
JWT_SECRET=your_jwt_secret_here_change_in_production
JWT_EXPIRE=7d
CORS_ORIGIN=http://localhost:5173
CLIENT_URL=http://localhost:5173

# =============================================================
# FRESH-INSTALL ADMIN BOOTSTRAP (production)
# On a completely empty database the server creates the first admin
# account from these credentials automatically at startup. If the
# database already has users this is ignored.
# Passing no/weak credentials on an empty database fails startup on
# purpose - there is never a default admin.
# =============================================================
ADMIN_EMAIL=
ADMIN_PASSWORD=

# =============================================================
# PAYMENT GATEWAY - REAL WORLD CHECKOUT
# Options (the first one configured wins, checked in this order:
# Razorpay -> Stripe -> UPI):
#
# 1. Razorpay (recommended - cards/UPI/wallets/netbanking):
#    Set RAZORPAY_KEY_ID + RAZORPAY_KEY_SECRET from https://dashboard.razorpay.com
#    Live keys (rzp_live_...) are required in production. Test keys
#    (rzp_test_...) are fine for development but are rejected in
#    production. Set RAZORPAY_WEBHOOK_SECRET and register the webhook
#    URL https://<your-host>/api/payments/razorpay/webhook on Razorpay
#    (events: payment.captured, payment.failed, payment.refunded) so
#    membership activation can also happen automatically server-side.
# 2. Stripe (cards) - set STRIPE_SECRET_KEY (sk_live_...):
#    Members pay through Stripe's hosted checkout. Requires a free
#    Stripe account: https://dashboard.stripe.com
# 3. UPI scan-to-pay (no API keys) - set UPI_ID:
#    Members scan a generated UPI QR with GPay/PhonePe/Paytm and
#    pay your UPI id directly. Set UPI_ID to your real UPI id,
#    e.g. yourname@oksbi. The placeholder fitsync@okaxis / @example /
#    "yourname@" are rejected and treated as not configured.
#    When Razorpay is configured, UPI stays available as a manual
#    gym-counter payment option.
#
# Member clicks never complete a payment by themselves. Razorpay's
# server-side signature + gateway capture check is required before a
# membership activates; UPI "I have paid" clicks keep the payment
# PENDING until a gym admin verifies it (Payments page). Only the
# gateway (or an admin for manual/UPI payments) can complete a payment.
#
# IMPORTANT: in NODE_ENV=production the server REFUSES to start without
# a real configuration. Use `npm run seed` for development demo data.
# =============================================================
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

UPI_ID=
UPI_NAME=FitSync AI Gym

# =============================================================
# EMAIL / SMS NOTIFICATIONS - OPTIONAL
# If unset, notifications are logged to the console instead.
# Email is sent for membership_expiry/high_risk/progress_anomaly/
# payment_due/announcement. SMS requires user phone + opt-in.
# =============================================================
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=FitSync AI <no-reply@fitsync.ai>

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# =============================================================
# ML SERVICE - OPTIONAL / NOT WIRED INTO THE API
# The Express server does NOT expose /api/ml/* routes and does not
# call this service. It only exists as a standalone ML experiments
# service (port 8001) - do not rely on it for any API behaviour.
# =============================================================
ML_SERVICE_URL=http://localhost:8001
ML_API_TOKEN=

# =============================================================
# SECURE PROFILE UPLOADS - OPTIONAL BOUNDS
# Size cap (in MB) for uploaded profile avatars, enforced server-side
# before storage. Defaults to 2 MB when unset.
# =============================================================
AVATAR_MAX_SIZE_MB=2
PHOTO_MAX_SIZE_MB=5

# =============================================================
# DEMO ACCOUNTS (development only - do NOT use in production)
# Run: npm run seed   (from project root or server/)
# The seed is idempotent - safe to run multiple times.
# =============================================================
#
# Admin:
#   Email: admin@fitsync.ai
#   Password: Admin@123
#
# Trainer:
#   Email: trainer@fitsync.ai
#   Password: Trainer@123
#
# Member:
#   Email: member@fitsync.ai
#   Password: Member@123
#
# All demo emails use the @fitsync.ai domain.
# Additional demo accounts are seeded automatically.

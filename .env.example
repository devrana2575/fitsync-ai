PORT=5000
MONGODB_URI=mongodb://localhost:27017/fitsync-ai
JWT_SECRET=your_jwt_secret_here_change_in_production
JWT_EXPIRE=7d
ML_SERVICE_URL=http://localhost:8001
CORS_ORIGIN=http://localhost:5173
CLIENT_URL=http://localhost:5173

# =============================================================
# PAYMENT GATEWAY - REAL WORLD CHECKOUT
# Two options (only one is used, checked in this order: Stripe -> UPI):
#
# 1. Stripe (cards) - set STRIPE_SECRET_KEY:
#    Members pay through Stripe's hosted checkout. Requires a free
#    Stripe account: https://dashboard.stripe.com
# 2. UPI scan-to-pay (no API keys) - set UPI_ID:
#    Members scan a generated UPI QR with GPay/PhonePe/Paytm and
#    pay your UPI id directly. Set UPI_ID to your real UPI id.
#    Healthy defaults: UPI_ID=#yourname@okaxis (disabled placeholder).
#
# If neither is set, checkout falls back to demo mode.
# =============================================================
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

UPI_ID=#yourname@okaxis
UPI_NAME=FitSync AI Gym

# =============================================================
# EMAIL / SMS NOTIFICATIONS - OPTIONAL
# If unset, notifications are logged to the console instead.
# Email is sent for membership_expiry/high_risk/progress_anomaly/
# payment_due/announcement. SMS requires user phone + opt-in.
# =============================================================
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=FitSync AI <no-reply@fitsync.ai>

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# =============================================================
# ML SERVICE - OPTIONAL
# Shared with the /api/ml prediction routes.
# =============================================================
ML_SERVICE_URL=http://localhost:8001
ML_API_TOKEN=

# =============================================================
# DEMO ACCOUNTS (development only - do NOT use in production)
# Run: npm run seed   (from project root or server/)
# The seed is idempotent - safe to run multiple times.
# =============================================================
#
# Admin:
#   Email: admin@fitsync.ai
#   Password: Admin@123
#
# Trainer:
#   Email: trainer@fitsync.ai
#   Password: Trainer@123
#
# Member:
#   Email: member@fitsync.ai
#   Password: Member@123
#
# All demo emails use the @fitsync.ai domain.
# Additional demo accounts are seeded automatically.
